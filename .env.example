PORT=1234
# Upstash Redis — native Redis URL (rediss://:token@host:port)
# Required for multi-instance horizontal scaling via pub/sub.
# Leave blank to run single-instance mode (pub/sub disabled, all existing behaviour preserved).
# Get from: Upstash Console → your DB → "Connect" → "ioredis" tab
UPSTASH_REDIS_URL=
# REDIS_URL from the Upstash TCP connection snippet is also supported.
# Next.js API base (snapshot persistence and live room authorization)
NEXTJS_API_URL=http://localhost:3000
# Must match the Next.js server; use at least 32 random characters. Required.
NEXTJS_INTERNAL_SECRET=
# Public browser origin, if different from NEXTJS_API_URL (for example behind a proxy).
COLLAB_ALLOWED_ORIGIN=http://localhost:3000
